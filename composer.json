{
    "name": "pixelperfectat/magento2-module-discount-lines-luma",
    "description": "Luma cart and checkout renderer for the Discount Lines module: one totals line per discount",
    "type": "magento2-module",
    "license": "MIT",
    "prefer-stable": true,
    "require": {
        "magento/framework": "^103.0",
        "magento/module-checkout": "^100.0",
        "magento/module-sales-rule": "^101.0",
        "php": "^8.3",
        "pixelperfectat/magento2-module-discount-lines": "^1.0"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "phpunit/phpunit": "^9.6",
        "pixelperfectat/coding-standard": "^0.2.1"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "PixelPerfect\\DiscountLinesLuma\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PixelPerfect\\DiscountLinesLuma\\Test\\": "Test/"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude generated .",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "infection": "infection --with-uncovered --min-msi=85 --min-covered-msi=90 --threads=max",
        "ci:validate": "@composer validate --no-check-publish",
        "check": [
            "@ci:validate",
            "@lint",
            "@cs",
            "@stan",
            "@test",
            "@test:js",
            "@infection"
        ],
        "test:js": "sh Test/Js/run.sh"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ]
}
